{
  "name": "cleanframe",
  "version": "0.6.1",
  "private": true,
  "description": "A personal, uncluttered home interface for Samsung The Frame.",
  "scripts": {
    "dev": "node scripts/run-python.mjs scripts/preview.py",
    "check": "npm run lint && node scripts/run-python.mjs scripts/check.py && npm run check:device",
    "package": "node scripts/run-python.mjs scripts/package.py",
    "tv:info": "node scripts/run-python.mjs scripts/tv.py info",
    "tv:install": "node scripts/run-python.mjs scripts/tv.py install",
    "tv:launch": "node scripts/run-python.mjs scripts/tv.py launch",
    "check:browser": "node scripts/check-browser.mjs",
    "dev:public": "node scripts/run-python.mjs scripts/preview.py --public-fonts",
    "export:public": "node scripts/run-python.mjs scripts/export-public.py",
    "check:public": "node scripts/run-python.mjs scripts/check-public.py",
    "check:tools": "node scripts/run-python.mjs -B scripts/test-tools.py",
    "lint": "eslint app",
    "check:device": "node --test scripts/test-device.mjs",
    "check:performance": "node scripts/check-performance.mjs"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
